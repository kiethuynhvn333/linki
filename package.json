{
  "name": "linki",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "wrangler dev --port 8787 --local-upstream localhost:8787 --upstream-protocol http",
    "test": "node --test",
    "db:local": "wrangler d1 migrations apply linki --local",
    "db:remote": "wrangler d1 migrations apply linki --remote",
    "deploy": "wrangler deploy",
    "release": "npm test && npm run db:remote && npm run deploy"
  },
  "devDependencies": {
    "miniflare": "^4.20260730.0",
    "wrangler": "^4"
  }
}
